# Plantilla de producción (§4.6). Copiar a .env en el servidor y completar. Luego:
#   php artisan key:generate && php artisan migrate --force && php artisan db:seed --force
#   php artisan optimize && npm ci && npm run build
# Cron (única línea obligatoria): * * * * * cd /ruta/app && php artisan schedule:run >> /dev/null 2>&1

APP_NAME="Indicadores Guadalupe"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://indicadores.tudominio.com
APP_TIMEZONE=America/Caracas
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=indicadores
DB_USERNAME=indicadores
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Correo para restablecer contraseñas y avisos de reapertura de mes.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="indicadores@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Usuario administrador inicial (cámbialo tras el primer acceso).
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@farmaciaguadalupe.com
ADMIN_PASSWORD=

# Tasa BCV: bcv (automática, 08:00 y 17:30) o null (solo manual).
RATES_PROVIDER=bcv
